# Backend environment variables (copy to .env)

NODE_ENV=development
PORT=5000

# Allowed frontend origin (CORS)
CLIENT_URL=http://localhost:5173

# MongoDB connection (Phase 3) - local or MongoDB Atlas free-tier URI
MONGODB_URI=mongodb://localhost:27017/depressionalert_ai
# Atlas: if mongodb+srv:// fails with "queryTxt ETIMEOUT" (network blocks
# DNS TXT lookups), use the standard multi-host form instead:
#   mongodb://user:pass@host0:27017,host1:27017,host2:27017/<db>?tls=true&authSource=admin&retryWrites=true&w=majority

# JWT session tokens (Proposal 7.1, SRS SEC-4/SEC-7)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Protected internal Python NLP/ML service (SRS 6.2)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=replace_with_internal_service_key

# High-risk alert threshold on the 0-100 risk score (SDD 6.3: >= 70 = High)
HIGH_RISK_THRESHOLD=70

# CSV upload handling (FR-5, SEC-6) - raw files are temporary and discarded
# after Post records are persisted (SDD 5)
MAX_CSV_FILE_SIZE_MB=5
CSV_UPLOAD_DIR=uploads
